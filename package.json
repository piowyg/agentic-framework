{
  "name": "agentic-framework",
  "version": "0.1.0",
  "private": true,
  "description": "A structured workflow for AI coding agents: grill → spec → breakdown → TDD in a sandbox → review → PR",
  "license": "Apache-2.0",
  "author": "Piotr Wygocki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piowyg/agentic-framework.git"
  },
  "homepage": "https://github.com/piowyg/agentic-framework#readme",
  "bugs": {
    "url": "https://github.com/piowyg/agentic-framework/issues"
  },
  "type": "module",
  "bin": {
    "agentic": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "catalog",
    "sandbox",
    "skills",
    "templates",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "tsx scripts/gen-docs.ts",
    "docs:check": "tsx scripts/gen-docs.ts --check",
    "ci": "npm run typecheck && npm test && npm run docs:check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.1.0",
    "picomatch": "^4.0.7",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "typebox": "^1.4.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
